# ServerManager per-server settings. Copy to config.env and edit.
# config.env is gitignored (may contain host-specific paths/secrets).

# Name of the Caddy container on this host.
CADDY_CONTAINER=caddy

# Access-log path INSIDE the Caddy container (matches templates/accesslog.snippet).
CADDY_LOGPATH=/data/access.log

# Host path to the Caddyfile (the bind-mount source you edit).
CADDYFILE_PATH=

# Directory of the Caddy docker-compose.yml (for --force-recreate applies).
CADDY_COMPOSE_DIR=

# Default reporting window, minutes.
WINDOW_MINUTES=10

# --- Alerting thresholds (for future tools/alerting) ---
# Warn if 429s in a window exceed this (brute-force / rate-limit pressure).
ALERT_429_PER_WINDOW=50
# Warn if 5xx responses in a window exceed this.
ALERT_5XX_PER_WINDOW=20
